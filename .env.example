# ─────────────────────────────────────────────────────────────
# Bokku Logistics — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_NAME="Bokku Logistics"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# API port
PORT=4000

# PostgreSQL 16 — local dev uses the credentials docker-compose / the
# dev setup script create. Replace for staging/production.
DATABASE_URL=postgresql://bokku:bokku_dev_password@127.0.0.1:5432/bokku_dev

# Redis 7
REDIS_URL=redis://127.0.0.1:6379

# JWT (use long random strings outside development)
JWT_SECRET=dev-only-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-change-me

# Payments (MOCK keeps the app fully functional without credentials)
PAYMENT_PROVIDER=MOCK
# Paystack
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Delivery providers (MOCK keeps the app fully functional without credentials)
DELIVERY_DEFAULT_PROVIDER=MOCK
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_API_URL=
BOLT_CLIENT_ID=
BOLT_CLIENT_SECRET=
BOLT_API_URL=

# SMTP (notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Error tracking
SENTRY_DSN=

# ── Phase 12: production hardening ──────────────────────────────
# CORS allowlist in production (comma-separated). Development is open.
CORS_ORIGINS=
# Swagger UI (defaults: on in dev/test, off in production)
SWAGGER_ENABLED=
# Redis-backed fixed-window rate limiting (defaults: on except NODE_ENV=test)
RATE_LIMIT_ENABLED=
# Bucket limits per minute (identity = user id when authed, else client IP)
RATE_LIMIT_DEFAULT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SENSITIVE_PER_MINUTE=60
